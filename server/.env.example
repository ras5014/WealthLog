# Database Configuration
DATABASE_URL=POSTGRES_URL

# Redis URL
REDIS_URL=

# Server Configuration
PORT=8080
NODE_ENV=development

# JWT Configuration
JWT_SECRET=asdfghasdf12345678901234qwertyuiopqwer$%
JWT_EXPIRES_IN=7d

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Security
BCRYPT_SALT_ROUNDS=12

# Logging
LOG_LEVEL=info

GROQ_API_KEY=

# ICICI Auto Sync
# Optional. Required only when the Auto login toggle is enabled.
ICICI_USER_ID=
ICICI_PASSWORD=
